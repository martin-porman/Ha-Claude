#!/usr/bin/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# Root Claude Code terminal (ttyd + tmux) on port 7681, no permission prompts.
export CLAUDE_CONFIG_DIR=/data/claude
export HOME=/data/claude-home
export PATH="/data/claude-home/.local/bin:${PATH}"
export IS_SANDBOX=1
export TERM=xterm-256color
_cc_token=$(bashio::config 'claude_code_oauth_token' '')
if [[ -n "${_cc_token}" && "${_cc_token}" != "null" ]]; then
    export CLAUDE_CODE_OAUTH_TOKEN="${_cc_token}"
fi
unset _cc_token
mkdir -p "${CLAUDE_CONFIG_DIR}" "${HOME}"
cd /config
bashio::log.info "Claude terminal: ttyd on port 7681"
exec ttyd --writable --port 7681 --ping-interval 30 \
    tmux new-session -A -s claude "claude --dangerously-skip-permissions; exec bash -l"
